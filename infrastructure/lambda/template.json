{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "PrivacyPrint expiry and cleanup worker",
  "Resources": {
    "ExpireJobsFunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": "lambda.amazonaws.com" },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "privacyprint-expire-job-policy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:Scan",
                    "dynamodb:Query",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:DeleteObject",
                    "s3:GetObject",
                    "s3:ListBucket"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "ExpireJobsFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "privacyprint-expire-jobs",
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "MemorySize": 256,
        "Timeout": 30,
        "Role": { "Fn::GetAtt": ["ExpireJobsFunctionRole", "Arn"] },
        "Code": {
          "ZipFile": "exports.handler = async (event) => { const jobs = Array.isArray(event && event.Records) ? event.Records : []; return { statusCode: 200, body: JSON.stringify({ processed: jobs.length }) }; };"
        },
        "Environment": {
          "Variables": {
            "JOBS_TABLE": "privacyprint-jobs",
            "TENANTS_TABLE": "privacyprint-tenants",
            "DOCUMENT_BUCKET": "privacyprint-documents"
          }
        }
      }
    }
  },
  "Outputs": {
    "ExpireJobsFunctionArn": { "Value": { "Fn::GetAtt": ["ExpireJobsFunction", "Arn"] } }
  }
}
