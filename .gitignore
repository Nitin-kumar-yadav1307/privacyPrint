# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Build output
dist/
build/
apps/api/public/
*.zip

# Temporary uploads
uploads/*
!uploads/.gitkeep

# Local private job metadata
apps/api/data/

# Databases
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# OS files
.DS_Store
# Print connector local artifacts (never commit documents)
services/print-connector/output/*
!services/print-connector/output/.gitkeep
services/print-connector/.tmp/
