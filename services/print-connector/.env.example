# Print connector configuration — copy to .env or export in the shell.
# Required:
SHOP_TOKEN=
#   Signed shop session token: sign in as your shop in the PrivacyPrint web
#   app, then copy the token (stored in localStorage as `shopToken`).

# Optional:
API_BASE_URL=http://localhost:3001
PRINT_MODE=auto
#   auto  = CUPS on Linux/macOS, SumatraPDF on Windows, PDF fallback otherwise
#   cups  = always real printing via lp/CUPS (Linux/macOS)
#   windows = always real printing via SumatraPDF (Windows)
#   pdf   = no hardware needed — verbatim PDF copy + settings manifest in output/
POLL_INTERVAL_MS=3000
# PRINTER_NAME=   # specific printer; auto-detected (lpstat / Windows default) if unset
# WIN_PRINT_TOOL=SumatraPDF.exe   # full path if SumatraPDF is not in PATH (Windows printing)
# PRINTER_NAME=   # specific CUPS printer (from `lpstat -p -d`); auto-detected if unset
