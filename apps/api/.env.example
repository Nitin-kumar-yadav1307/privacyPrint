# PrivacyPrint API configuration — copy to .env for local development.
# Everything below is optional; a bare `npm start` works with defaults.

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Storage locations (defaults live inside apps/api)
# UPLOAD_DIR=./uploads
# DATA_DIR=./data

# Shop session secret.
# In development a random per-process secret is generated (restarts log everyone out).
# In production this MUST be set to a long random value — the API refuses to boot without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=

# Shop session lifetime in seconds (default 3600 = 1 hour)
# SESSION_TTL_SECONDS=3600

# Shared demo passcode for shop sign-in (hackathon mock auth — replace with a
# real identity provider before any real deployment).
# SHOP_DEMO_PASSCODE=privacyprint-demo

# Set to true to make shop sessions mandatory on shop-only operations
# (recommended in any shared environment).
# AUTH_REQUIRED=false
